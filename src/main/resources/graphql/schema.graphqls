type Query {
    products: [Product!]!
    productsByCategory(categoryId: ID!): [Product!]!
    categories: [Category!]!
    category(id: ID!): Category
    productsPage(page: Int = 0, size: Int = 5, keyword: String): ProductPage!
    categoriesPage(page: Int = 0, size: Int = 5, keyword: String): CategoryPage!
}

type Mutation {
    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
}

input CategoryInput {
    categoryName: String!
    icon: String
}

input ProductInput {
    productName: String!
    unitPrice: Float!
    discount: Float = 0
    quantity: Int!
    status: Int!
    description: String
    images: String
    categoryId: ID!
}

type Product {
    productId: ID!
    productName: String!
    quantity: Int!
    unitPrice: Float!
    images: String
    description: String
    discount: Float!
    status: Int!
    category: Category!
}

type Category {
    categoryId: ID!
    categoryName: String!
    icon: String
    products: [Product!]!
}

type ProductPage {
    content: [Product!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type CategoryPage {
    content: [Category!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}
